#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:60
msgid "PPPoE Dial-up"
msgstr "宽带拨号"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:61
msgid "Broadband account"
msgstr "宽带账号"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:62
msgid "Dial up with the broadband account and password supplied by your ISP. Choose this when the line requires PPPoE authentication."
msgstr "使用运营商提供的宽带账号和密码拨号。当线路需要 PPPoE 认证时选择此项。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:67
msgid "DHCP Client"
msgstr "连接现有路由器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:68
msgid "Existing router"
msgstr "已有路由器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:69
msgid "Obtain an address automatically from an upstream modem or router. This is the usual choice for a new router behind an existing gateway."
msgstr "从上级光猫或路由器自动获取地址。这是新路由器接在现有网关之后的常见选择。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:74
msgid "Side Router"
msgstr "旁路由"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:75
msgid "Keep the main router"
msgstr "保留主路由器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:76
msgid "Keep the existing main router and use this device for additional services. LAN clients use this device as their gateway."
msgstr "保留现有主路由器，将此设备用于附加服务。局域网客户端将把此设备作为网关。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:270
msgid "Configuration applied successfully."
msgstr "配置已成功应用。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:387
msgid "Not configured"
msgstr "未配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:387
msgid "No wireless radio"
msgstr "无无线网卡"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:388
msgid "Enabled"
msgstr "已开启"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:388
msgid "Disabled"
msgstr "已关闭"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:397
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:510
msgid "Smart NetPilot"
msgstr "智能网络向导"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:398
msgid "Network setup"
msgstr "网络设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:401
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:511
msgid "Guided setup"
msgstr "引导式设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:402
msgid "Set up your network with confidence"
msgstr "放心完成网络设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:403
msgid "Choose how this router connects to the internet. Smart NetPilot guides you through the essential settings and applies them safely."
msgstr "选择本路由器接入互联网的方式。智能网络向导会引导你完成关键设置，并安全地应用配置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:405
msgid "Automatic light and dark theme"
msgstr "自动适配明暗主题"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:406
msgid "Validated before apply"
msgstr "应用前校验"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:407
msgid "IPv4 and IPv6"
msgstr "IPv4 与 IPv6"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:411
msgid "Current mode"
msgstr "当前模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:412
msgid "Management address"
msgstr "管理地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:412
msgid "Unknown"
msgstr "未知"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:413
msgid "Wireless"
msgstr "无线"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:414
msgid "HTTPS management"
msgstr "HTTPS 管理"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:421
msgid "Choose a connection mode"
msgstr "选择连接方式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:422
msgid "Pick the description that matches your internet line. You can change it later without losing the other settings."
msgstr "选择与你的宽带线路相符的说明。之后可以更改，且不会丢失其他设置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:424
#, javascript-format
msgid "%d modes"
msgstr "%d 种模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:433
msgid "Not sure which one to choose? If another router already provides Wi-Fi, use “DHCP Client”. If your ISP gave you a broadband account, use “PPPoE Dial-up”."
msgstr "不确定该选哪个？如果已有其他路由器提供 Wi-Fi，请选择“连接现有路由器”；如果运营商提供了宽带账号，请选择“宽带拨号”。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:463
msgid "Current"
msgstr "当前"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:470
#, javascript-format
msgid "Configure %s"
msgstr "配置 %s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:493
#, javascript-format
msgid "Could not save the selected mode. %s"
msgstr "无法保存所选模式。%s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:514
msgid "Configuration"
msgstr "配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:522
msgid "Selected mode"
msgstr "所选模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:529
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:586
msgid "Change mode"
msgstr "更改模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:538
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:603
msgid "Network Mode"
msgstr "网络模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:539
msgid "WAN Settings"
msgstr "WAN 设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:541
msgid "Wireless Settings"
msgstr "无线设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:541
msgid "Set the wireless name and password. For advanced options, open Network → Wireless."
msgstr "设置无线名称和密码。更多高级选项请打开“网络 → 无线”。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:542
msgid "Other Settings"
msgstr "其他设置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:619
msgid "Configure LAN port addressing"
msgstr "配置 LAN 口地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:625
msgid "LAN address mode"
msgstr "LAN 地址模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:626
msgid "DHCP client mode takes the LAN address from the upstream router. Check the upstream lease table to find the new address."
msgstr "DHCP 客户端模式下，LAN 地址由上级路由器分配。请在上级路由器的租约列表中查找新地址。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:628
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:662
msgid "Static IPv4 address"
msgstr "静态 IPv4 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:629
msgid "DHCP client (assigned upstream)"
msgstr "DHCP 客户端（由上级分配）"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:633
msgid "LAN IPv4 address"
msgstr "LAN IPv4 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:634
msgid "The management address of this router. Choose an address outside the upstream DHCP pool."
msgstr "本路由器的管理地址。请选择上级 DHCP 地址池之外的地址。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:642
msgid "LAN IPv4 netmask"
msgstr "LAN IPv4 子网掩码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:653
msgid "LAN IPv4 gateway"
msgstr "LAN IPv4 网关"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:654
msgid "Side router only: enter the address of the main router. It must be in the same subnet as this router."
msgstr "仅旁路由模式：输入主路由器的地址，且必须与本路由器处于同一子网。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:659
msgid "WAN address mode"
msgstr "WAN 地址模式"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:660
msgid "Choose how the WAN interface obtains its address."
msgstr "选择 WAN 接口获取地址的方式。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:663
msgid "DHCP client"
msgstr "DHCP 客户端"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:667
msgid "Side router DNS servers"
msgstr "旁路由 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:668
msgid "DNS servers handed to LAN clients. Leave empty to use the defaults."
msgstr "下发给局域网客户端的 DNS 服务器。留空则使用默认值。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:672
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:731
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:757
msgid "Ali DNS: 223.5.5.5"
msgstr "阿里 DNS：223.5.5.5"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:673
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:732
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:758
msgid "Baidu DNS: 180.76.76.76"
msgstr "百度 DNS：180.76.76.76"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:674
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:733
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:759
msgid "114 DNS: 114.114.114.114"
msgstr "114 DNS：114.114.114.114"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:675
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:734
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:760
msgid "Google DNS: 8.8.8.8"
msgstr "Google DNS：8.8.8.8"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:676
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:735
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:761
msgid "Cloudflare DNS: 1.1.1.1"
msgstr "Cloudflare DNS：1.1.1.1"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:679
msgid "WAN device"
msgstr "WAN 设备"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:680
msgid "Physical network port used for the internet connection."
msgstr "用于连接互联网的物理网络端口。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:695
msgid "This is the switch CPU port, not a physical network port."
msgstr "这是交换机 CPU 口，不是物理网络端口。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:700
msgid "PPPoE username"
msgstr "PPPoE 用户名"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:704
msgid "PPPoE password"
msgstr "PPPoE 密码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:709
msgid "WAN IPv4 address"
msgstr "WAN IPv4 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:714
msgid "WAN IPv4 netmask"
msgstr "WAN IPv4 子网掩码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:723
msgid "WAN IPv4 gateway"
msgstr "WAN IPv4 网关"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:728
msgid "Custom DNS servers"
msgstr "自定义 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:729
msgid "Leave empty to obtain DNS servers automatically."
msgstr "留空则自动获取 DNS 服务器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:739
msgid "Enable IPv6"
msgstr "启用 IPv6"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:740
msgid "Configure IPv6 on the WAN and LAN interfaces. Disable it if your ISP does not provide IPv6."
msgstr "在 WAN 和 LAN 接口上启用 IPv6。如果你的运营商不提供 IPv6，请关闭。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:744
msgid "Disable the LAN DHCP server"
msgstr "关闭 LAN DHCP 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:745
msgid "Only one DHCP server should run on a network. Disable this router’s server when the main router already provides one."
msgstr "同一网络中只应运行一个 DHCP 服务器。如果主路由器已提供 DHCP，请关闭本路由器的服务器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:749
msgid "Advertise a DNS server to LAN clients"
msgstr "向局域网客户端通告 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:750
msgid "Force LAN clients to use the DNS server selected below."
msgstr "强制局域网客户端使用下方选择的 DNS 服务器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:755
msgid "DNS server to advertise"
msgstr "向外通告的 DNS 服务器"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:756
msgid "Use this router’s LAN address"
msgstr "使用本路由器的 LAN 地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:765
msgid "Redirect management to HTTPS"
msgstr "将管理页面重定向到 HTTPS"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:766
msgid "Generate a local certificate and redirect HTTP requests to HTTPS."
msgstr "生成本地证书，并将 HTTP 请求重定向到 HTTPS。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:772
msgid "Wireless name (SSID)"
msgstr "无线名称（SSID）"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:775
msgid "Enter a wireless name"
msgstr "输入无线名称"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:778
msgid "Wireless password"
msgstr "无线密码"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:782
msgid "At least 8 characters"
msgstr "至少 8 个字符"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:787
msgid "Enable SYN-flood protection"
msgstr "启用 SYN Flood 防护"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:788
msgid "Recommended. Protects the router and LAN clients from SYN-flood attacks."
msgstr "推荐开启。保护路由器和局域网客户端免受 SYN Flood 攻击。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:816
#, javascript-format
msgid "The management address will change from %s to %s. The current page will disconnect and then open the new address."
msgstr "管理地址将从 %s 变为 %s。当前页面会断开连接，然后打开新地址。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:819
msgid "The LAN interface will become a DHCP client. Its new address is assigned by the upstream router, so it cannot be predicted. Find the lease in the upstream router after applying."
msgstr "LAN 接口将变为 DHCP 客户端。其新地址由上级路由器分配，无法预先确定。应用后请在上级路由器中查找租约。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:824
msgid "Management access will switch to HTTPS after the configuration is applied."
msgstr "配置应用后，管理页面将切换为 HTTPS。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:825
msgid "HTTPS redirection will be disabled. Management access will return to HTTP after the configuration is applied."
msgstr "HTTPS 重定向将被关闭。配置应用后，管理页面将恢复为 HTTP。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:829
msgid "The wireless name or password changed. Wireless clients will need to reconnect."
msgstr "无线名称或密码已更改，无线客户端需要重新连接。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:885
msgid "Apply cancelled."
msgstr "已取消应用。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:889
#, javascript-format
msgid "Configuration could not be saved. %s"
msgstr "配置无法保存。%s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:902
msgid "There are no changes to apply."
msgstr "没有需要应用的更改。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:908
msgid "Could not prepare the configuration apply. Please try again."
msgstr "无法准备应用配置，请重试。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:926
#, javascript-format
msgid "Apply request failed with status %s."
msgstr "应用请求失败（状态 %s）。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:962
msgid "Configuration applied without confirmation."
msgstr "配置已应用，未启用自动回滚确认。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:978
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1164
msgid "The configuration could not be applied."
msgstr "无法应用配置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:983
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1116
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1156
msgid "Configuration confirmed. The new settings are kept."
msgstr "已确认配置，新设置将保留。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1066
#, javascript-format
msgid "If you do not confirm within %d seconds, the previous configuration is restored automatically."
msgstr "如果在 %d 秒内未确认，将自动恢复之前的配置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1074
msgid "Keep configuration"
msgstr "保留配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1082
msgid "Roll back now"
msgstr "立即回滚"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1112
msgid "Saving confirmation…"
msgstr "正在保存确认…"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1123
msgid "The device did not confirm the configuration. Please try again."
msgstr "设备未能确认配置，请重试。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1133
#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1147
msgid "Restoring the previous configuration…"
msgstr "正在恢复之前的配置…"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1178
msgid "The new settings were applied. Keep them, or the previous configuration will be restored automatically."
msgstr "新设置已应用。请保留它们，否则将自动恢复之前的配置。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1180
msgid "Rollback in"
msgstr "回滚倒计时"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1182
msgid "s"
msgstr "秒"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1188
#, javascript-format
msgid "New management address: %s"
msgstr "新的管理地址：%s"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1191
msgid "Confirm the new configuration"
msgstr "确认新配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1232
msgid "Reconnect to the previous address"
msgstr "重新连接到之前的地址"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1241
msgid "Close"
msgstr "关闭"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1244
msgid "Restoring the previous configuration"
msgstr "正在恢复之前的配置"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1247
msgid "The previous network settings are being restored. The connection will be interrupted; reconnect to the router once it is done."
msgstr "正在恢复之前的网络设置。连接会中断，完成后请重新连接到路由器。"

#: htdocs/luci-static/resources/view/smartnetpilot/smartnetpilot.js:1248
#, javascript-format
msgid "Previous management address: %s"
